# Values only; never commit real credentials or secret files.
ENVIRONMENT=production
FREIGHT_BACKEND_IMAGE=ghcr.io/appolon1908-hue/freight-platform-backend@sha256:REDACTED
FREIGHT_BACKEND_NETWORK=freight_private

DATABASE_URL=postgresql+asyncpg://freight_api:REDACTED@postgres.internal/freight
WORKER_DATABASE_URL=postgresql+asyncpg://freight_integration_worker:REDACTED@postgres.internal/freight
OIDC_ISSUER=https://auth.codestra.co/realms/codestra
OIDC_AUDIENCE=freight-platform-api
OIDC_JWKS_URL=https://auth.codestra.co/realms/codestra/protocol/openid-connect/certs

INTEGRATION_ALLOWED_HOSTS=n8n.internal.codestra.co,odoo.internal.codestra.co
INTEGRATION_SECRETS_ENV_FILE=/etc/codestra/secrets/freight-integrations.env
GATEWAY_SHARED_SECRET_FILE=/etc/codestra/secrets/freight-gateway-proof
COMPLIANCE_IDENTIFIER_PEPPER_FILE=/etc/codestra/secrets/freight-compliance-pepper

FORWARDED_ALLOW_IPS=10.40.0.0/24
TRUSTED_GATEWAY_CIDRS=10.40.0.0/24
WORKER_POLL_SECONDS=2
DELIVERY_CONCURRENCY=8
OUTBOX_FANOUT_BATCH=50
DELIVERY_CLAIM_BATCH=25
INBOUND_CLAIM_BATCH=25
